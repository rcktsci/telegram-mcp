# Master token for the web UI and REST management API.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If empty/unset - every /api/* request is rejected (fail closed).
UI_MASTER_TOKEN=

# Media links (get_media_link): public base URL serving /files/<code>.
# Non-empty values override config.yml; an EMPTY value falls through to
# config.yml. Only when empty everywhere does get_media_link refuse to
# hand out links (fail closed).
MEDIA_LINKS_PUBLIC_URL=
MEDIA_LINKS_TTL_SECONDS=300
MEDIA_LINKS_MAX_DOWNLOAD_SECONDS=60
MEDIA_LINKS_MAX_DOWNLOAD_MB=200
